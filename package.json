{
  "name": "@sebastian-gmbh/paratix-workspace",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:integration": "pnpm --filter paratix test:integration",
    "typecheck": "pnpm typecheck:root && pnpm typecheck:packages",
    "typecheck:root": "tsc -p tsconfig.root.json --noEmit",
    "typecheck:packages": "pnpm -r --filter './packages/*' exec tsc --noEmit && pnpm -r --filter './packages/*' exec tsc -p tsconfig.typecheck.json && pnpm --filter @sebastian-gmbh/paratix-website typecheck",
    "lint": "concurrently --kill-others-on-fail --passthrough-arguments --names lint:oxlint,lint:eslint 'pnpm lint:oxlint' 'pnpm lint:eslint'",
    "lint:oxlint": "oxlint -c oxlint.config.ts",
    "lint:eslint": "eslint --max-warnings=0",
    "e18e:analyze": "pnpx @e18e/cli analyze",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "agent:check:integration": "pnpm agent:check && pnpm test:integration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/paratix.git"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/paratix/issues"
  },
  "author": "Sebastian Fastner <s.fastner@sebastian-software.de>",
  "license": "MIT",
  "homepage": "https://paratix.oss.sebastian-software.com",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@types/node": "24.13.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-setup": "^0.5.2",
    "jiti": "^2.7.0",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
