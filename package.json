{
  "name": "@sebastian-gmbh/paratix-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts && eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian-software/paratix.git"
  },
  "author": "Sebastian Fastner <s.fastner@sebastian-software.de>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "ssh2"
    ]
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "eslint": "^10.0.3",
    "eslint-config-setup": "^0.3.3",
    "jiti": "^2.6.1",
    "oxlint": "^1.55.0",
    "prettier": "^3.8.1"
  }
}
