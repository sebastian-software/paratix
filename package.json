{
  "name": "@sebastian-gmbh/paratix-workspace",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter paratix test:integration",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit",
    "lint": "concurrently --kill-others-on-fail --passthrough-arguments --names lint:oxlint,lint:eslint 'pnpm lint:oxlint' 'pnpm lint:eslint'",
    "lint:oxlint": "oxlint -c oxlint.config.ts",
    "lint:eslint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test",
    "agent:check:integration": "pnpm agent:check && pnpm test:integration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/paratix.git"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/paratix/issues"
  },
  "author": "Sebastian Fastner <s.fastner@sebastian-software.de>",
  "license": "MIT",
  "homepage": "https://paratix.oss.sebastian-software.com",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "ssh2"
    ]
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "eslint": "^10.3.0",
    "eslint-config-setup": "^0.4.0",
    "jiti": "^2.6.1",
    "concurrently": "^9.1.2",
    "oxlint": "^1.62.0",
    "prettier": "^3.8.3"
  }
}
