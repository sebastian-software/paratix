{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>sebastian-software/renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Inactive Vitest canary preparation: replace the false match only after the reviewed issue 37 E enforcement, isolation and native-runtime gates pass.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vitest",
        "@vitest/coverage-v8",
        "@vitest/coverage-istanbul",
        "@vitest/ui",
        "@vitest/browser",
        "@vitest/browser-playwright",
        "@vitest/browser-preview",
        "@vitest/browser-webdriverio"
      ],
      "matchJsonata": [
        "false"
      ],
      "postUpgradeTasks": {
        "commands": [
          "/opt/renovate/toolchains/candidate43-consumer11/node/bin/node /opt/renovate/releases/vitest-eaf25235679c46bb3259f70babcfd1da4a8e7e70/scripts/vitest-lockstep.mjs"
        ],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "fileFilters": [
          "**/package.json",
          "pnpm-lock.yaml"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "#255: update the russh SSH stack of packages/ssh-native together; russh-sftp tracks russh releases.",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "packages/ssh-native/**"
      ],
      "matchPackageNames": [
        "russh",
        "russh-sftp"
      ],
      "groupName": "russh"
    },
    {
      "description": "#255 (until the C1 release of @paratix/ssh-native): require Dependency Dashboard approval for every Cargo and npm update under packages/ssh-native so no fix(deps) commit triggers a release before C1. Remove this rule after the C1 release so security updates trigger releases again.",
      "matchManagers": [
        "cargo",
        "npm"
      ],
      "matchFileNames": [
        "packages/ssh-native/**"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
