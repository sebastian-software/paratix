{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>sebastian-software/renovate-config",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "Inactive Vitest canary preparation: replace the false match only after the reviewed issue 37 E enforcement, isolation and native-runtime gates pass.",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vitest",
        "@vitest/**"
      ],
      "matchJsonata": [
        "false"
      ],
      "postUpgradeTasks": {
        "commands": [
          "/opt/renovate/toolchains/candidate43-consumer11/node/bin/node /opt/renovate/releases/vitest-72eccad55567efd96e87fb215a6aaa81201920a1/scripts/vitest-lockstep.mjs"
        ],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "fileFilters": [
          "**/package.json",
          "pnpm-lock.yaml"
        ],
        "executionMode": "branch"
      }
    }
  ]
}
