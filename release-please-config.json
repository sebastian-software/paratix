{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "plugins": [
    {
      "type": "linked-versions",
      "components": ["paratix", "create-paratix", "ssh-native"],
      "groupName": "paratix workspace packages"
    }
  ],
  "packages": {
    "packages/create-paratix": {
      "component": "create-paratix",
      "package-name": "create-paratix",
      "release-type": "node"
    },
    "packages/paratix": {
      "component": "paratix",
      "package-name": "paratix",
      "release-type": "node"
    },
    "packages/ssh-native": {
      "component": "ssh-native",
      "package-name": "@paratix/ssh-native",
      "release-type": "node",
      "extra-files": [
        {
          "type": "json",
          "path": "npm/linux-x64-gnu/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "npm/linux-arm64-gnu/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "npm/linux-x64-musl/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "npm/linux-arm64-musl/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "npm/darwin-x64/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "npm/darwin-arm64/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
