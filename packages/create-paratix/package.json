{
  "name": "create-paratix",
  "version": "0.18.0",
  "description": "Scaffold a new Paratix server project",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "create-paratix": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && pnpm test:dist",
    "test:dist": "pnpm build && vitest run --config vitest.distribution.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ssh2": "^1.15.4",
    "tsup": "^8.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "scaffold",
    "cli",
    "create",
    "paratix",
    "project-generator",
    "template",
    "vps",
    "server"
  ],
  "homepage": "https://paratix.oss.sebastian-software.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/paratix.git",
    "directory": "packages/create-paratix"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/paratix/issues"
  },
  "author": "Sebastian Fastner <s.fastner@sebastian-software.de>",
  "license": "MIT"
}
