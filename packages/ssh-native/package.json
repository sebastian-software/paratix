{
  "name": "@paratix/ssh-native",
  "version": "0.24.0",
  "description": "Native SSH transport for Paratix: a thin napi-rs binding over russh and russh-sftp",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "loader.js",
    "lib/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "napi": {
    "binaryName": "ssh-native",
    "dtsHeaderFile": "dts-header.txt",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --no-js --dts index.d.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\"",
    "test:integration": "node test/integration/run.mjs docker",
    "test:integration:local": "node test/integration/run.mjs local",
    "test:smoke": "node test/smoke/smoke.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.9",
    "@types/node": "24.19.2",
    "ssh2": "^1.17.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "keywords": [
    "paratix",
    "ssh",
    "sftp",
    "russh",
    "napi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/paratix.git",
    "directory": "packages/ssh-native"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/paratix/issues"
  },
  "author": "Sebastian Fastner <s.fastner@sebastian-software.de>"
}
