{
  "name": "paratix",
  "version": "0.22.1",
  "description": "Idempotent VPS setup tool in TypeScript",
  "type": "module",
  "files": [
    "dist",
    "llm-guide.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./modules": "./dist/modules/index.js"
  },
  "bin": {
    "paratix": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "pnpm test:unit && pnpm test:dist",
    "test:coverage": "vitest run --coverage",
    "test:dist": "pnpm build && vitest run --config vitest.distribution.config.ts",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "ssh2": "^1.16.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "5.0.4",
    "tsup": "^8.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "paratix",
    "vps",
    "server",
    "ssh",
    "deployment",
    "idempotent",
    "typescript",
    "devops",
    "infrastructure",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/paratix.git",
    "directory": "packages/paratix"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/paratix/issues"
  },
  "author": "Sebastian Fastner <s.fastner@sebastian-software.de>",
  "license": "MIT"
}
