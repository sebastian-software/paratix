{
  "name": "paratix",
  "version": "0.1.0",
  "description": "Idempotent VPS setup tool in TypeScript",
  "type": "module",
  "files": [
    "dist",
    "llm-guide.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./modules": "./dist/modules/index.js"
  },
  "bin": {
    "paratix": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "ssh2": "^1.16.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/ssh2": "^1.15.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "paratix",
    "vps",
    "server",
    "ssh",
    "deployment",
    "idempotent",
    "typescript",
    "devops",
    "infrastructure",
    "automation"
  ],
  "homepage": "https://paratix.oss.sebastian-software.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/paratix.git",
    "directory": "packages/paratix"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/paratix/issues"
  },
  "author": "Sebastian Fastner <s.fastner@sebastian-software.de>",
  "license": "MIT"
}
